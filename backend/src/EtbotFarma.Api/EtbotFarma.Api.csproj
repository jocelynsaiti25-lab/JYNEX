<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Api: punto de entrada HTTP. Controladores delgados que solo envían commands/queries. -->
  <PropertyGroup>
    <RootNamespace>EtbotFarma.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Seguridad: fuerza la versión corregida de Microsoft.OpenApi
         (la 2.0.0 que trae por defecto tiene la vulnerabilidad GHSA-v5pm-xwqc-g5wc) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtbotFarma.Application\EtbotFarma.Application.csproj" />
    <ProjectReference Include="..\EtbotFarma.Infrastructure\EtbotFarma.Infrastructure.csproj" />
  </ItemGroup>

</Project>
