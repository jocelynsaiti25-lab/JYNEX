<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application: casos de uso (CQRS). Solo depende de Domain. -->
  <PropertyGroup>
    <RootNamespace>EtbotFarma.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR 12.5.0: última versión con licencia libre (Apache 2.0) -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <!-- FluentValidation (Apache 2.0): reglas de validación de entrada de cada Command -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!-- Registro automático de todos los validators en la inyección de dependencias -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtbotFarma.Domain\EtbotFarma.Domain.csproj" />
  </ItemGroup>

</Project>
