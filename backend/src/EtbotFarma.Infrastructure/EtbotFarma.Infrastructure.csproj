<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: detalles técnicos (SQL con MySQL, hash de contraseñas, tokens).
       Implementa las interfaces que define Application. -->
  <PropertyGroup>
    <RootNamespace>EtbotFarma.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Da acceso a IServiceCollection, IConfiguration y PasswordHasher -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Conector oficial de la comunidad para MySQL (ADO.NET). Con él se escribe SQL a mano:
         el proyecto NO usa Entity Framework ni ningún ORM.
         Versión 2.6.2: corrige la vulnerabilidad GHSA-473q-m89c-ghf8. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtbotFarma.Application\EtbotFarma.Application.csproj" />
  </ItemGroup>

</Project>
