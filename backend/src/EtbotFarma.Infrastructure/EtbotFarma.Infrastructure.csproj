<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: detalles técnicos (base de datos, hash de contraseñas, tokens).
       Implementa las interfaces que define Application. -->
  <PropertyGroup>
    <RootNamespace>EtbotFarma.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Da acceso a IServiceCollection, IConfiguration y PasswordHasher -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Proveedor de MySQL para Entity Framework Core.
         Pomelo 9.0.0 usa EF Core 9 (funciona en .NET 10; todavía no hay versión para EF Core 10). -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtbotFarma.Application\EtbotFarma.Application.csproj" />
  </ItemGroup>

</Project>
